# Copy this file to .env (in this hw4 folder) and add your Portkey key.
# .env is listed in .gitignore, so your real key is never committed.
# All AI calls use the gpt-5.6-luna model through the Portkey gateway.
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional settings (the defaults work for local development):
# API_PORT=8000          # backend port; start the front end with the same value
